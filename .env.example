# Environment Mode (development | production | test)
NODE_ENV=production
PORT=3000

# PostgreSQL Database (AWS RDS / Remote PostgreSQL with SSL)
DATABASE_URL=postgresql://db_user:db_password@your-rds-host.ap-south-1.rds.amazonaws.com:5432/routine_ai?sslmode=require

# JWT Authentication (Secure random string, minimum 32 chars in puction)
JWT_SECRET=your_secure_random_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Application & CORS Domain Settings
APP_URL=https://routineai.app
FRONTEND_URL=https://routineai.app

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OpenRouter AI Provider
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-placeholder
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Stripe Subscription Billing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_test_id
STRIPE_PRICE_PRO_YEARLY=price_pro_yearly_test_id
STRIPE_PRICE_PRO_FAMILY_MONTHLY=price_pro_family_monthly_test_id
STRIPE_PRICE_PRO_FAMILY_YEARLY=price_pro_family_yearly_test_id

# Security / Developer Options (Set to false or omit in production)
ALLOW_DEV_LOGIN=false
